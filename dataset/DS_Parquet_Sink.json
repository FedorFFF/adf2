{
	"name": "DS_Parquet_Sink",
	"properties": {
		"description": "Parquet Sink",
		"linkedServiceName": {
			"referenceName": "AzureBlobStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"prm_Container": {
				"type": "string",
				"defaultValue": "dummy"
			},
			"prm_Directory": {
				"type": "string"
			},
			"prm_FileName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": "@dataset().prm_FileName",
				"folderPath": "@dataset().prm_Directory",
				"container": "@dataset().prm_Container"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}